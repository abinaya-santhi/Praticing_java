import java.util.*;
class Main {
    public static void main(String[] args) {
        
        int arr[] = new int[]{0,0,0001,0,0,0,1};
        int index =0;
        for(int num: arr){
            if(num != 0){
                arr[index++] = num;
            }
        }
        while (index < arr.length){
            arr[index++] = 0;
        }
        for (int i = 0 ; i < arr.length ; i++){
            System.out.print(arr[i]+" ");
        }
        
    }
}
