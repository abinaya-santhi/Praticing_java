import java.util.*;
class Main {
    public static void main(String[] args) {
        
        int arr[] = new int[]{1,2,3,4,5,6};

        int largest = arr[0]; int smallest = arr[0];
        for (int i = 0; i < arr.length ; i++){
            if (arr [i] > largest){
                largest = arr[i];
            }
            if (arr[i] < smallest){
                smallest = arr[i];
            }
        }
        System.out.print(largest +" "+smallest);
    }
}
