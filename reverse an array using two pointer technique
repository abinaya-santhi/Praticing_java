import java.util.*;
class Main {
    public static void main(String[] args) {
        
        int arr[] = new int[]{11,16,12,15,13,14};
        int left = 0;
        int right = arr.length -1;
        while(left < right){
            int temp = arr[left];
            arr[left] = arr[right];
            arr[right] = temp;
            left++; right--;
        }
        System.out.print(Arrays.toString(arr));
        
    }
}
